FROM eclipse-temurin:21-jre-jammy
VOLUME /tmp
ARG JAR_FILE=target/*.jar
COPY ${JAR_FILE} app.jar

ARG CONFIG_SERVER_URI=http://config-server:8888
ARG CONFIG_SERVER_IMPORT=configserver:http://config-server:8888
ARG PROFILE=default

ARG CATEGORY_DB_HOST=category-db
ARG CATEGORY_DB_PORT=5432
ARG CATEGORY_DB_NAME=category
ARG CATEGORY_DB_USERNAME=category
ARG CATEGORY_DB_PASSWORD=category

ENV CATEGORY_DB_HOST=${CATEGORY_DB_HOST}
ENV CATEGORY_DB_PORT=${CATEGORY_DB_PORT}
ENV CATEGORY_DB_NAME=${CATEGORY_DB_NAME}
ENV CATEGORY_DB_USERNAME=${CATEGORY_DB_USERNAME}
ENV CATEGORY_DB_PASSWORD=${CATEGORY_DB_PASSWORD}

ENV CONFIG_SERVER_URI=${CONFIG_SERVER_URI}
ENV CONFIG_SERVER_IMPORT=${CONFIG_SERVER_IMPORT}
ENV SPRING_PROFILES_ACTIVE=${PROFILE}
ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar /app.jar"]